# Groq API key — server-side only, never expose to client
# Get it from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override model (default: openai/gpt-oss-20b)
# Examples: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b
GROQ_MODEL=your_model_here

# Optional: set to "1" to show dev ad placeholder in NativeAd (default: hidden)
# NEXT_PUBLIC_ADS_DEBUG=1
